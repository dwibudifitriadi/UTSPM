<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.NB.Headline" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/nb_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.NB.Body" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/nb_text_primary</item>
    </style>

    <style name="TextAppearance.NB.Button" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/nb_text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.NB.EditText" parent="android:Widget.EditText">
        <item name="android:background">@drawable/bg_input_nb</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/nb_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Style untuk TextInputLayout Material -->
    <style name="Widget.NB.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/nb_border</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="hintTextColor">@color/nb_text_secondary</item>
        <item name="android:textColorHint">@color/nb_text_secondary</item>
        <item name="startIconTint">@color/nb_border</item>
        <item name="errorIconTint">@color/nb_primary</item>
        <item name="errorTextColor">@color/nb_primary</item>
    </style>
</resources>