<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape>
                    <solid android:color="@color/nb_shadow"/>
                    <corners android:radius="0dp"/>
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/nb_accent"/>
                    <stroke android:width="2dp" android:color="@color/nb_border"/>
                    <corners android:radius="0dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape>
                    <solid android:color="@color/nb_shadow"/>
                    <corners android:radius="0dp"/>
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/nb_bg_secondary"/>
                    <stroke android:width="2dp" android:color="@color/nb_border"/>
                    <corners android:radius="0dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>