<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Garis bawah tebal sebagai border bawah -->
    <item
        android:top="-2dp"
        android:bottom="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/nb_border_width"
                android:color="@color/nb_border"/>
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
</layer-list>