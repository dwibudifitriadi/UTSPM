<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nb_shadow"/>
        </shape>
    </item>
    <item android:bottom="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nb_accent"/>
            <stroke android:width="2dp" android:color="@color/nb_border"/>
        </shape>
    </item>
</layer-list>