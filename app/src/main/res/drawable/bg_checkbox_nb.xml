<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nb_shadow"/>
                    <corners android:radius="0dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nb_secondary"/>
                    <stroke android:width="2dp" android:color="@color/nb_border"/>
                    <corners android:radius="0dp"/>
                </shape>
            </item>
            <!-- Tanda centang -->
            <item android:drawable="@drawable/ic_check_white" android:gravity="center"/>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nb_shadow"/>
                    <corners android:radius="0dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nb_card_bg"/>
                    <stroke android:width="2dp" android:color="@color/nb_border"/>
                    <corners android:radius="0dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>