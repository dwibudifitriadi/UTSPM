<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State Terpilih -->
    <item android:state_checked="true">
        <layer-list>
            <!-- Shadow Blok -->
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nb_shadow"/>
                </shape>
            </item>
            <!-- Tombol Utama -->
            <item android:bottom="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nb_secondary"/>
                    <stroke android:width="2dp" android:color="@color/nb_border"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- State Normal -->
    <item>
        <layer-list>
            <!-- Shadow Blok -->
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nb_shadow"/>
                </shape>
            </item>
            <!-- Tombol Utama -->
            <item android:bottom="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nb_card_bg"/>
                    <stroke android:width="2dp" android:color="@color/nb_border"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>