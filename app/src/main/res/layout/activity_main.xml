<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            style="@style/TextAppearance.NB.Headline"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tab_login"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_nb"
                android:gravity="center"
                android:text="MASUK"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/nb_text_primary"
                android:clickable="true"
                android:focusable="true"
                android:state_selected="true"/>

            <TextView
                android:id="@+id/tab_register"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_nb"
                android:gravity="center"
                android:text="DAFTAR"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/nb_text_primary"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/container_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="0dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/bg_card_nb">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Masuk ke Akun"
                    style="@style/TextAppearance.NB.Body"
                    android:layout_marginBottom="24dp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_login_username"
                    style="@style/Widget.NB.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Username"
                    app:startIconDrawable="@drawable/ic_person_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_login_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_login_password"
                    style="@style/Widget.NB.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:hint="Kata Sandi"
                    app:startIconDrawable="@drawable/ic_logout"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_login_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btn_login_submit"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_nb"
                    android:text="MASUK"
                    android:textAllCaps="false"
                    style="@style/TextAppearance.NB.Button"
                    android:stateListAnimator="@null"
                    android:elevation="0dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/container_register"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/bg_card_nb">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daftar Akun Baru"
                    style="@style/TextAppearance.NB.Body"
                    android:layout_marginBottom="24dp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_username"
                    style="@style/Widget.NB.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Username"
                    app:startIconDrawable="@drawable/ic_person_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_email"
                    style="@style/Widget.NB.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Email"
                    app:startIconDrawable="@drawable/ic_email_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_hp"
                    style="@style/Widget.NB.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Nomor HP"
                    app:startIconDrawable="@drawable/ic_chat">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_hp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_password"
                    style="@style/Widget.NB.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Kata Sandi"
                    app:startIconDrawable="@drawable/ic_logout"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_confirm_password"
                    style="@style/Widget.NB.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="Konfirmasi Kata Sandi"
                    app:startIconDrawable="@drawable/ic_logout"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jenis Kelamin"
                    style="@style/TextAppearance.NB.Body"
                    android:layout_marginBottom="8dp"/>
                <RadioGroup
                    android:id="@+id/rg_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">
                    <RadioButton
                        android:id="@+id/rb_male"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Laki-laki"
                        android:button="@null"
                        android:background="@drawable/bg_radio_nb"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/nb_text_primary"/>
                    <RadioButton
                        android:id="@+id/rb_female"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Perempuan"
                        android:button="@null"
                        android:background="@drawable/bg_radio_nb"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/nb_text_primary"/>
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minat (pilih minimal satu)"
                    style="@style/TextAppearance.NB.Body"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">
                    <CheckBox
                        android:id="@+id/cb_edu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Edukasi"
                        android:button="@null"
                        android:background="@drawable/bg_checkbox_nb"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:textSize="14sp"
                        android:textColor="@color/nb_text_primary"/>
                    <CheckBox
                        android:id="@+id/cb_sport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:text="Sports"
                        android:button="@null"
                        android:background="@drawable/bg_checkbox_nb"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:textSize="14sp"
                        android:textColor="@color/nb_text_primary"/>
                    <CheckBox
                        android:id="@+id/cb_game"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Game"
                        android:button="@null"
                        android:background="@drawable/bg_checkbox_nb"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:textSize="14sp"
                        android:textColor="@color/nb_text_primary"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Kota"
                    style="@style/TextAppearance.NB.Body"
                    android:layout_marginBottom="8dp"/>
                <Spinner
                    android:id="@+id/spinner_city"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_spinner_nb"
                    android:padding="12dp"
                    android:popupBackground="@color/nb_card_bg"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="24dp"/>

                <Button
                    android:id="@+id/btn_register_submit"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_button_nb"
                    android:text="DAFTAR"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    style="@style/TextAppearance.NB.Button"
                    android:padding="0dp"
                    android:stateListAnimator="@null"
                    android:elevation="0dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>